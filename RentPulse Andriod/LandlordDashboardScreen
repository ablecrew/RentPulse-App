@Composable
fun LandlordDashboardScreen() {
    val scrollState = rememberScrollState()
    var selectedTab by remember { mutableStateOf("This Month") }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(
                Brush.verticalGradient(
                    colors = listOf(
                        Color(0xFF007BFF).copy(alpha = 0.20f),
                        Color(0xFF007BFF).copy(alpha = 0.05f)
                    ),
                    startY = 0f,
                    endY = 800f
                )
            )
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .verticalScroll(scrollState)
        ) {
            // Top Bar with notification, welcome text and menu
            TopBarSection()

            Spacer(modifier = Modifier.height(20.dp))

            // Stats Row - Tenants and Properties
            StatsRow()

            Spacer(modifier = Modifier.height(20.dp))

            // Payments Overview Card
            PaymentsOverviewCard(
                selectedTab = selectedTab,
                onTabSelected = { selectedTab = it }
            )

            Spacer(modifier = Modifier.height(20.dp))

            // Tenant Directory
            TenantDirectoryCard()

            Spacer(modifier = Modifier.height(20.dp))

            // M-Pesa Reconciliation
            MPesaReconciliationCard()

            Spacer(modifier = Modifier.height(20.dp))

            // Payment Predictor (AI)
            PaymentPredictorCard()

            Spacer(modifier = Modifier.height(20.dp))

            // Recent Payments
            RecentPaymentsCard()

            Spacer(modifier = Modifier.height(20.dp))

            // RentPulse Ad Image
            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .padding(horizontal = 16.dp)
                    .height(180.dp)
                    .clip(RoundedCornerShape(16.dp))
                    .background(Color(0xFF1a1a2e))
            ) {
                // Placeholder for ad image
                Column(
                    modifier = Modifier
                        .fillMaxSize()
                        .padding(24.dp),
                    verticalArrangement = Arrangement.Bottom
                ) {
                    Text(
                        text = "RentPulse",
                        fontSize = 32.sp,
                        fontWeight = FontWeight.Bold,
                        color = Color.White
                    )
                    Spacer(modifier = Modifier.height(8.dp))
                    Text(
                        text = "Smarter Property Management.",
                        fontSize = 16.sp,
                        color = Color.White.copy(alpha = 0.8f)
                    )
                }
            }

            Spacer(modifier = Modifier.height(100.dp))
        }

        // Bottom Navigation
        BottomNavigationBar(
            modifier = Modifier.align(Alignment.BottomCenter)
        )
    }
}

